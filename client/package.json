  },
  "scripts": {
    "start": "react-scripts start",
    "build": "node scripts/check-vercel-env.cjs && react-scripts build",
    "start:vite": "vite",
    "build:vite": "node scripts/check-vercel-env.cjs && vite build",
    "preview:vite": "vite preview --host 0.0.0.0",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --watchAll=false --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=json-summary --collectCoverageFrom=src/**/*.{ts,tsx} --collectCoverageFrom=!src/**/*.d.ts",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "7.24.7",
    "@babel/plugin-proposal-private-property-in-object": "7.21.0-placeholder-for-preset-env.2",
    "@babel/plugin-syntax-flow": "7.24.7",
    "@babel/plugin-transform-react-jsx": "7.24.7",
    "@vitejs/plugin-react": "4.3.4",
    "sass": "^1.77.6",
    "vite": "5.4.19"
  }
