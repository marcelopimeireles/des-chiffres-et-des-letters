# URL of the backend, for deployed frontend builds
REACT_APP_API_URL=http://localhost:5000/api/game

# Optional: path or URL to an exported Rive .riv scene.
# When empty, the app renders an animated CSS studio illustration instead.
# Export a state machine named Studio with triggers intro, draw, success.
REACT_APP_RIVE_STUDIO_SRC=

# Vercel frontend: set at Project Settings > Environment Variables BEFORE building.
# The deployed URL must be HTTPS and end with /api/game (no trailing slash).
# REACT_APP_API_URL=https://your-express-api.vercel.app/api/game
# CRA embeds REACT_APP_* values into its JavaScript bundle; never put secrets here.
